# This fstab is a template based on legacy Samsung Qualcomm partition layout.
# The exact partition numbers must be confirmed on the target device.

#<src>                                                  <mnt_point>      <type>  <mnt_flags>         <fs_mgr_flags>
/dev/block/mmcblk0p9                                     /system          ext4    ro,barrier=1        wait
/dev/block/mmcblk0p10                                    /data            ext4    nosuid,nodev,noatime,discard   wait,check
/dev/block/mmcblk0p8                                     /cache           ext4    nosuid,nodev,noatime,discard   wait,check
/dev/block/mmcblk0p11                                    /sdcard          vfat    nosuid,nodev,uid=1023,gid=1023,flush,fmask=0000,dmask=0000,wait
/dev/block/mmcblk0p5                                     /boot            emmc    defaults            recoveryonly
/dev/block/mmcblk0p6                                     /recovery        emmc    defaults            recoveryonly
/dev/block/mmcblk0p7                                     /misc            emmc    defaults            recoveryonly
/dev/block/mmcblk0p2                                     /efs             ext4    nosuid,nodev,nomblk_io_submit,barrier=1,errors=panic    wait,check
